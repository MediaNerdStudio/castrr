PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
MEDIA_DIR=./media
DATA_DIR=./data

# Optional: protect admin routes. Generate a hash with: node scripts/hash-password.mjs
ADMIN_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Spotify client credentials for enriching tracklist metadata
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
