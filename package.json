{
  "name": "casterr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cross-env PORT=3001 npm run dev:server\" \"cross-env PORT=3000 npm --prefix ui run dev\"",
    "dev:server": "nodemon server/index.js",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "npm --prefix ui run build",
    "build:server": "echo Server is pure Node.js, no build step needed.",
    "start": "node server/index.js",
    "lint": "npm --prefix ui run lint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "geoip-lite": "^2.0.3",
    "get-audio-duration": "^4.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10"
  }
}
